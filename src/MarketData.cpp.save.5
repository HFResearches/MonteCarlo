uint64_t xValue{1234567};

inline uint64_t valorXS(){
  xValue ^= xValue << 13;
  xValue ^= xValue >> 7;
  xValue ^= xValue << 17;

  return xValue;
}

inline double rand_range(double min,
  double max){

  return min + (max - min) * (valorXS() / 
   18446744073709551616.0);
}

double r1{0.01};
double r2{0.100};
inline double variancia(){
  double rTurn = rand_range(r1, r2);
  return rTurn;
}

void MonteCarlo(){
  period.reserve(1024);
  candle c;
  double d,d1={0.0}; 
    

  while(true){
    for(std::atomic<size_t> a{0uz}; a < 1024;
      a++){
       
      for(std::atomic<size_t> x{0uz};
        x.load(std::memory_order_relaxed)
        < 4; x++){
        
          
        d = variancia();
        d1 = variancia();

        cashflow[x.load(std::memory_order_relaxed)] =
          totalAssets + (d - d1);
      }

      for(std::atomic<size_t> x{0uz};
        x.load(std::memory_order_relaxed) < 4; x++){

        d = variancia();
        d1 = variancia();

        Cashflow[x.load(std::memory_order_relaxed)] =
          cashflow[x.load(std::memory_order_relaxed)] + (d - d1);
      }

      c.open = 
        Cashflow[0];

      c.close = 
        Cashflow[3];

      c.high = *std::max_element(
        std::begin(Cashflow),
        std::end(Cashflow));
      
      c.low = *std::min_element(
        std::begin(Cashflow),
        std::end(Cashflow));

//      std::cout << std::setprecision(6) << c.open << "|" << c.high
//      << "|" << c.low << "|" << c.close << "\n";   

      {
        std::lock_guard<std::mutex> lock(mtx);
        period.push_back(c);
      }
    } 
  }
}

size_t idx(size_t x){
  for(size_t a{0}; a
    < period.size(); a++){
    try{
      size_t r = (a <= period.size()) ? a : 
        ((a > x) && (a != x)) ? a - x :
        ((a < x) && (a != x)) ? (x - a) :
         (a + x) - x;
    
    
      if(r > 0 && r <= period.size()) return r;

      if(r <= 0 && r > period.size()){
        throw std::runtime_error
          ("completely out of the freaking index!\n");
        
        std::this_thread::sleep_for(
          std::chrono::milliseconds(10));
      }

    }catch(const std::exception& ex){
      std::cerr << "error:" << ex.what() << "\n";
    }
  }
 
  return 0uz;
}

